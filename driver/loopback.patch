 #define EFFECTS_LIST_COUNT 2
 
+// Lock order: stream position lock -> mixer lock. The mixer never touches streams.
+// Every callback holds the stream's miniport reference; teardown drains its timer first.
+#pragma code_seg()
+ULONG CMiniportWaveRT::AcquireLoopbackSource()
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_AudioFlowLoopbackLock, &irql);
+    ULONG source = m_AudioFlowLoopback ? m_AudioFlowLoopback->Acquire() : AudioFlowLoopback::InvalidSource;
+    KeReleaseSpinLock(&m_AudioFlowLoopbackLock, irql);
+    return source;
+}
+
+VOID CMiniportWaveRT::ReleaseLoopbackSource(ULONG Source)
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_AudioFlowLoopbackLock, &irql);
+    if (m_AudioFlowLoopback) m_AudioFlowLoopback->Release(Source);
+    KeReleaseSpinLock(&m_AudioFlowLoopbackLock, irql);
+}
+
+VOID CMiniportWaveRT::ResetLoopbackSource(ULONG Source)
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_AudioFlowLoopbackLock, &irql);
+    if (m_AudioFlowLoopback) m_AudioFlowLoopback->Reset(Source);
+    KeReleaseSpinLock(&m_AudioFlowLoopbackLock, irql);
+}
+
+VOID CMiniportWaveRT::MuteLoopback(BOOL Muted)
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_AudioFlowLoopbackLock, &irql);
+    if (m_AudioFlowLoopback) m_AudioFlowLoopback->SetMuted(Muted != FALSE);
+    KeReleaseSpinLock(&m_AudioFlowLoopbackLock, irql);
+}
+
+VOID CMiniportWaveRT::PublishLoopback(ULONG Source, ULONGLONG Frame, const BYTE* Buffer, ULONG Bytes)
+{
+    // Bound work under each lock, even when a delayed timer catches up.
+    while (Bytes >= AudioFlowLoopback::FrameBytes)
+    {
+        const ULONG frames = min(Bytes / AudioFlowLoopback::FrameBytes, 256UL);
+        KIRQL irql;
+        KeAcquireSpinLock(&m_AudioFlowLoopbackLock, &irql);
+        if (m_AudioFlowLoopback) m_AudioFlowLoopback->Write(Source, Frame,
+            reinterpret_cast<const short*>(Buffer), frames);
+        KeReleaseSpinLock(&m_AudioFlowLoopbackLock, irql);
+        Frame += frames;
+        Buffer += frames * AudioFlowLoopback::FrameBytes;
+        Bytes -= frames * AudioFlowLoopback::FrameBytes;
+    }
+}
+
+VOID CMiniportWaveRT::CaptureLoopback(ULONGLONG Frame, BYTE* Buffer, ULONG Bytes)
+{
+    while (Bytes >= AudioFlowLoopback::FrameBytes)
+    {
+        const ULONG frames = min(Bytes / AudioFlowLoopback::FrameBytes, 256UL);
+        KIRQL irql;
+        KeAcquireSpinLock(&m_AudioFlowLoopbackLock, &irql);
+        if (m_AudioFlowLoopback) m_AudioFlowLoopback->Read(Frame,
+            reinterpret_cast<short*>(Buffer), frames);
+        else RtlZeroMemory(Buffer, frames * AudioFlowLoopback::FrameBytes);
+        KeReleaseSpinLock(&m_AudioFlowLoopbackLock, irql);
+        Frame += frames;
+        Buffer += frames * AudioFlowLoopback::FrameBytes;
+        Bytes -= frames * AudioFlowLoopback::FrameBytes;
+    }
+}
+
+// Windows 11 24H2 asks the loopback pin which tap point it supports.
+#pragma code_seg("PAGE")
+NTSTATUS PropertyHandler_AudioFlowLoopbackCaps(_In_ PPCPROPERTY_REQUEST Request)
+{
+    PAGED_CODE();
+    if (Request->Verb & KSPROPERTY_TYPE_BASICSUPPORT)
+        return PropertyHandler_BasicSupport(Request, Request->PropertyItem->Flags, VT_UI4);
+    if (!(Request->Verb & KSPROPERTY_TYPE_GET)) return STATUS_INVALID_DEVICE_REQUEST;
+    if (Request->ValueSize == 0)
+    {
+        Request->ValueSize = sizeof(ULONG);
+        return STATUS_BUFFER_OVERFLOW;
+    }
+    if (Request->ValueSize < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
+    *static_cast<ULONG*>(Request->Value) = AUDIOLOOPBACK_TAPPOINT_CAPS_PREVOLUMEMUTE;
+    Request->ValueSize = sizeof(ULONG);
+    return STATUS_SUCCESS;
+}
