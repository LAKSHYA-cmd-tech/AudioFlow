; AudioFlow Output render-only prototype, derived from Microsoft's SysVAD sample.
; The accompanying SysVAD source and LICENSE are in src/.
[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/04/2026, 0.2.4.0
CatalogFile = audioflowoutput.cat
PnpLockDown = 1

[SourceDisksNames]
222="AudioFlow Driver Disk","",222

[SourceDisksFiles]
AudioFlowOutput.sys=222

[Manufacturer]
%MfgName%=AudioFlow,NT$ARCH$.10.0...22621

[AudioFlow.NT$ARCH$.10.0...22621]
%AudioFlow.DeviceDesc%=AudioFlow_Install, Root\AudioFlow_Output

[DestinationDirs]
AudioFlow.CopyList=13

[AudioFlow.CopyList]
AudioFlowOutput.sys

[AudioFlow_Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=AudioFlow.CopyList
AddReg=AudioFlow.AddReg

[AudioFlow.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,AudioFlowOutput.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%AudioFlow.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%AudioFlow.DeviceDesc%

[AudioFlow_Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, AudioFlow.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, AudioFlow.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, AudioFlow.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, AudioFlow.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, AudioFlow.TopologySpeaker

[AudioFlow.WaveSpeaker]
AddReg=AudioFlow.WaveSpeaker.AddReg

[AudioFlow.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AudioFlow.OutputName%

[AudioFlow.TopologySpeaker]
AddReg=AudioFlow.TopologySpeaker.AddReg

[AudioFlow.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AudioFlow.OutputName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[AudioFlow_Install.NT.Services]
AddService=audioflowoutput,0x00000002,AudioFlow.Service

[AudioFlow.Service]
DisplayName=%AudioFlow.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\AudioFlowOutput.sys
AddReg=AudioFlow.Service.AddReg

[AudioFlow.Service.AddReg]
; Disable unused sample capture tones. AudioFlow loopback uses real render data.
HKR,Parameters,DisableToneGenerator,0x00010001,1

[AudioFlow_Install.NT.HW]
AddReg=AudioFlow.Hardware.AddReg

[AudioFlow.Hardware.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[AudioFlow_Install.NT.Wdf]
KmdfService=audioflowoutput,AudioFlow.Wdf

[AudioFlow.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="AudioFlow"
MfgName="AudioFlow"
AudioFlow.DeviceDesc="AudioFlow Virtual Audio Device"
AudioFlow.ServiceDesc="AudioFlow Virtual Audio Device Driver"
AudioFlow.OutputName="AudioFlow Output"
KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
