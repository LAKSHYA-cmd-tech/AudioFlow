<Window x:Class="AudioFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AudioFlow.Models" Style="{StaticResource AppWindowStyle}" Title="AudioFlow" Width="1200" Height="800" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#171A24" BorderBrush="#30364A" BorderThickness="0,0,0,1">
      <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" Background="#796BFF" CornerRadius="10"><TextBlock Text="〽" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="AudioFlow" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="YOUR SOUND, YOUR WAY" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>
        <Button x:Name="MenuButton" Grid.Column="1" Content="☰" FontSize="23" Width="46" Height="42"
                AutomationProperties.Name="Open navigation menu" Click="MenuButton_Click">
          <Button.ContextMenu>
            <ContextMenu Background="#20242F" Foreground="White">
              <MenuItem Header="Equalizer" Foreground="White" Click="ShowEqualizer_Click"/>
              <MenuItem Header="Mixer and profiles" Foreground="White" Click="ShowMixer_Click"/>
              <MenuItem Header="Settings" Foreground="White" Click="ShowSettings_Click"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>
    </Border>
  <TabControl x:Name="Pages" Grid.Row="1" SelectedIndex="1" Background="#101219" BorderThickness="0" Padding="0">
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl">
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
        </Border>
      </ControlTemplate>
    </TabControl.Template>
    <TabItem Header="Mixer">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#151821" Padding="22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,34"><Border Width="36" Height="36" Background="#796BFF" CornerRadius="11"><TextBlock Text="〽" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="AudioFlow" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="Windows audio, simplified" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel>
          <TextBlock Text="PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0" Foreground="White">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#312D58"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#272B36"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          </ListBox>
          <StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="＋ New" Command="{Binding AddProfileCommand}" Margin="0,0,8,0"/><Button Content="Delete" Command="{Binding DeleteProfileCommand}"/></StackPanel>
          <Button Content="Apply saved profile" Command="{Binding ApplyProfileCommand}" Margin="0,6"/>
          <TextBlock Text="{Binding SelectedProfile.Summary}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Button Content="Exit AudioFlow" Command="{Binding ExitCommand}" HorizontalAlignment="Stretch"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,24,30,26">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your audio" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding ActivitySummary}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/></Grid>
      <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="18" Margin="0,22,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DEFAULT OUTPUT DEVICE" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Margin="0,8,0,0" AutomationProperties.Name="Output device"/></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" IsEnabled="{Binding HasOutput}"><TextBlock Text="MASTER VOLUME" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="1" Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Grid.Column="1" Content="Mute" IsChecked="{Binding MasterMuted, Mode=TwoWay}" VerticalAlignment="Center"/></Grid></StackPanel><Button Grid.Column="2" Content="Save current mix" Command="{Binding SaveProfileCommand}" Background="#796BFF" VerticalAlignment="Bottom" Margin="18,0,0,0"/></Grid></Border>
      <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="8">
        <DockPanel><Grid DockPanel.Dock="Top" Margin="12,8,12,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="APPLICATIONS" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10"/><TextBlock Grid.Column="1" Text="VOLUME" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10"/><TextBlock Grid.Column="2" Text="MUTE" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10"/></Grid>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Sessions}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:AudioSession}"><Grid Margin="8,4" MinHeight="58" Background="#272B36"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="9" Background="#3B4050" VerticalAlignment="Center"><TextBlock Text="{Binding IconText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10"><Run Text="{Binding ProcessName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PlaybackStatus, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding OutputDeviceName}" ToolTip="{Binding OutputDeviceName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><Grid Grid.Column="2" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0:P0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid><CheckBox Grid.Column="3" IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mute"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,16,0,0"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="AUTOMATION" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10"/><TextBlock Text="Switch profiles when an app runs or a device connects" Margin="0,3,0,0"/></StackPanel><Button Content="Manage rules" Click="ManageRules_Click" HorizontalAlignment="Right"/></DockPanel></Border>
    </Grid>
  </Grid>
    </TabItem>
    <TabItem Header="Tuning">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="EqualizerContent" Margin="30,26" MaxWidth="1450" HorizontalAlignment="Stretch">
          <TextBlock Text="AUDIOFLOW  /  EQUALIZER" FontSize="10" FontWeight="Bold" Foreground="#A89DFF"/>
          <TextBlock Text="Shape your sound" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0"/>
          <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                     Text="Eleven essential bands up front. Add precision only when you need it."/>
          <Border CornerRadius="16" Padding="22" Margin="0,18,0,0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#342C61" Offset="0"/><GradientStop Color="#24263C" Offset="1"/></LinearGradientBrush></Border.Background>
            <StackPanel>
              <TextBlock Text="CURRENT PRESET" FontSize="10" FontWeight="Bold" Foreground="#C4BAFF"/>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name" MinWidth="270" MaxWidth="400" HorizontalAlignment="Left"
                          AutomationProperties.Name="Equalizer profile"/>
                <CheckBox Grid.Column="1" Content="Enable EQ preview" IsChecked="{Binding GraphicEqActive, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="18,0,0,0"/>
              </Grid>
              <TextBlock Text="Preview only · Audio from games, music apps and Windows is not changed yet."
                         Foreground="#C1C1D3" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,16,0,0">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Core EQ" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="11 starting bands · click or drag a band to edit it" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="+ Add band" Command="{Binding AddGraphicEqBandCommand}" Background="#796BFF" Margin="0,0,8,0"/>
                  <Button Content="Reset flat" Command="{Binding ResetGraphicEqCommand}"/>
                </StackPanel>
              </Grid>
              <Border Height="1" Background="#373C4B" Margin="0,16,0,14"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
                <ListBox x:Name="EqBandsList" ItemsSource="{Binding Dsp.GraphicBands}" SelectedItem="{Binding SelectedEqBand, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Foreground="White">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EqBandItem_PreviewMouseLeftButtonDown"/>
                      <Setter Property="Padding" Value="6,10"/>
                      <Setter Property="Margin" Value="2,0"/>
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="BandCard" Background="#292D3B" BorderBrush="#3C4151" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BandCard" Property="Background" Value="#333849"/></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="BandCard" Property="Background" Value="#40396B"/><Setter TargetName="BandCard" Property="BorderBrush" Value="#9A8DFF"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate></Setter.Value></Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Width="67" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <Slider Style="{StaticResource EqGainSliderStyle}" Orientation="Vertical" Height="154" Minimum="-24" Maximum="24" IsEnabled="{Binding UsesGain}"
                                TickFrequency="1" Value="{Binding GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center" Margin="0,9,0,9"/>
                        <TextBlock Text="{Binding ShortFrequency}" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#C8C2E8"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
              <Border Background="#272B36" CornerRadius="12" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="LIVE BAND VALUE" FontSize="10" FontWeight="Bold" Foreground="#ACA0FF"/>
                      <TextBlock x:Name="LiveBandValue" Text="{Binding SelectedEqBand.Label}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="#393259" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                      <TextBlock Text="Drag to tune" Foreground="#D3C9FF" FontSize="11"/>
                    </Border>
                  </Grid>
                  <Border Height="1" Background="#3D4251" Margin="0,15,0,2"/>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="16"/><ColumnDefinition Width="145"/><ColumnDefinition Width="16"/><ColumnDefinition Width="95"/><ColumnDefinition Width="16"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="FREQUENCY · Hz" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                      <TextBox Text="{Binding SelectedEqBand.Frequency, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="FILTER TYPE" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                      <ComboBox ItemsSource="{Binding GraphicEqTypes}" SelectedItem="{Binding SelectedEqBand.Type, Mode=TwoWay}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Q · WIDTH" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                      <TextBox Text="{Binding SelectedEqBand.Q, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" IsEnabled="{Binding SelectedEqBand.UsesGain}">
                      <TextBlock Text="GAIN · dB" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                      <TextBox Text="{Binding SelectedEqBand.GainDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox Content="Use this band" IsChecked="{Binding SelectedEqBand.Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    <Button Content="Remove selected band" Command="{Binding RemoveGraphicEqBandCommand}" Margin="18,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="Q changes how narrow or broad a filter is. Boost gently to avoid clipping in the preview."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Hear your curve" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Play the looping sample, then move an EQ slider to hear its effect immediately. Stop playback when finished."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,12" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Play original" Command="{Binding PreviewBeforeCommand}" Margin="0,0,8,0"/>
                <Button Content="Play with EQ" Command="{Binding PreviewAfterCommand}" Background="#796BFF" Margin="0,0,8,0"/>
                <Button Content="Stop" Command="{Binding StopPreviewCommand}"/>
              </StackPanel>
              <TextBlock Text="{Binding EqPreviewStatus}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Settings">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="Startup and background" FontSize="18" Margin="0,26,0,12"/>
          <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeStartupHere}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding StartupDescription}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="22,0,0,16"/>
          <Button Content="Windows startup settings" Command="{Binding OpenStartupSettingsCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
          <CheckBox Content="Open in system tray" IsChecked="{Binding StartMinimized}" Margin="0,0,0,8"/>
          <TextBlock Text="Hide the main window when you open AudioFlow. Launch it again or use the tray icon to show it." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="22,0,0,16"/>
          <TextBlock Text="Closing the window keeps AudioFlow running in the tray. Use Exit AudioFlow to stop it completely." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
          <TextBlock Text="Diagnostics" FontSize="18" Margin="0,18,0,12"/>
          <TextBlock Text="Errors are saved locally to help troubleshoot audio and startup problems. Logs rotate automatically and are not uploaded." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
          <TextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
          <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,24,0,16"/>
          <Button Content="Exit AudioFlow" Command="{Binding ExitCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
  </Grid>
</Window>
