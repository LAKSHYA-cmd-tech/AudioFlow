<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AudioFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AudioFlow Pro · Precision Studio Mastering &amp; Spatial Engine" mc:Ignorable="d">

    <Grid Background="#090D15" RequestedTheme="Dark">
        <Grid.Resources>
            <!-- Bespoke Studio Dark Theme Palette -->
            <SolidColorBrush x:Key="AppBackground" Color="#090D15" />
            <SolidColorBrush x:Key="PanelBrush" Color="#0D131F" />
            <SolidColorBrush x:Key="CardBrush" Color="#121A2A" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#182338" />
            <SolidColorBrush x:Key="BorderBrush" Color="#1E2B40" />
            <SolidColorBrush x:Key="BorderLightBrush" Color="#283955" />
            <SolidColorBrush x:Key="MutedBrush" Color="#768B9E" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#4A5C6F" />
            
            <!-- Neon Accents -->
            <SolidColorBrush x:Key="AccentBrush" Color="#00E5FF" />
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#0072CE" />
            <SolidColorBrush x:Key="NeonVioletBrush" Color="#A855F7" />
            <SolidColorBrush x:Key="NeonPinkBrush" Color="#EC4899" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />

            <!-- Card & Surface Styles -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom App Title Bar -->
        <TitleBar x:Name="AppTitleBar" Title="AudioFlow Pro · Precision Studio Mastering &amp; Spatial Engine" Subtitle="v1.0 · 64-Bit Zero-Latency DSP Architecture"/>

        <!-- Top Master Console Bar (Unified Audiophile Header Deck) -->
        <Border x:Name="MasterConsoleBar" Grid.Row="1" Margin="14,0,14,6" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Master Engine Power, Route Status Badge, and DSP Bypass -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="MasterPowerButton" Click="MasterPowerButton_Click" Height="38" Padding="16,0" CornerRadius="8"
                            Background="#0072CE" Foreground="White" BorderThickness="1" BorderBrush="#80F2FF">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PowerIcon" Text="⏻" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PowerLabel" Text="START ENGINE" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border x:Name="StatusBadge" Background="#112233" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="StatusBadgeText" Text="READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#121A2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,2" VerticalAlignment="Center" Height="36">
                        <ToggleSwitch x:Name="MasterBypassToggle" Header="" OffContent="DSP Active" OnContent="DSP Bypassed" Toggled="MasterBypassToggle_Toggled" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Middle: Master Preamp, Latency, and Smart A/B Memory -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                    <!-- Preamp Fader -->
                    <Border Background="#090D15" BorderBrush="#192537" BorderThickness="1" CornerRadius="8" Padding="8,4" Width="155" Height="48">
                        <StackPanel Spacing="1">
                            <Grid>
                                <TextBlock Text="PREAMP GAIN" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="PreampValText" Text="0.0 dB" FontSize="9.5" FontFamily="Consolas, Cascadia Code, monospace" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Slider x:Name="PreampSlider" Minimum="-15" Maximum="15" Value="0" StepFrequency="0.5" ValueChanged="PreampSlider_ValueChanged" Foreground="{StaticResource AccentBrush}" Height="26"/>
                        </StackPanel>
                    </Border>

                    <!-- Latency Selector -->
                    <Border Background="#090D15" BorderBrush="#192537" BorderThickness="1" CornerRadius="8" Padding="6,4" Width="140" Height="48">
                        <StackPanel Spacing="1">
                            <TextBlock Text="BUFFER LATENCY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox x:Name="LatencyModePicker" SelectionChanged="LatencyModePicker_SelectionChanged" HorizontalAlignment="Stretch" FontSize="10" Height="26">
                                <ComboBoxItem Content="⚡ 25ms Ultra"/>
                                <ComboBoxItem Content="⚖️ 60ms Balance"/>
                                <ComboBoxItem Content="🛡️ 160ms Safe"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Smart Auto-Gain & A/B Memory Slots -->
                    <Border Background="#090D15" BorderBrush="#192537" BorderThickness="1" CornerRadius="8" Padding="6,3" Height="48">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button x:Name="SlotAButton" Content="🅰️ Slot A" Click="SlotA_Click" FontSize="9" Padding="5,2" CornerRadius="4" Background="#16253C" Foreground="{StaticResource AccentBrush}"/>
                                <Button x:Name="SlotBButton" Content="🅱️ Slot B" Click="SlotB_Click" FontSize="9" Padding="5,2" CornerRadius="4" Background="#161F2E" Foreground="{StaticResource MutedBrush}"/>
                                <Button Content="⇄ A/B" Click="QuickAbCompare_Click" FontSize="9" Padding="5,2" CornerRadius="4" Background="#1C2E46" Foreground="White"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoGainCheck" Content="⚡ Auto-Gain Trim" Click="AutoGainCheck_Click" FontSize="8.5" Padding="4,0,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Height="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Precision Stereo VU Meters & Limiter Protection & Mini-HUD -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- In Level -->
                    <Border Background="#090D15" BorderBrush="#192537" BorderThickness="1" CornerRadius="8" Padding="8,4" Width="105" Height="48">
                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="IN L/R" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="InDbfsText" Text="-∞ dB" FontSize="8.5" FontFamily="Consolas, Cascadia Code, monospace" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="MeterInL" Minimum="0" Maximum="100" Height="4.5" CornerRadius="2" Foreground="{StaticResource AccentBrush}"/>
                            <ProgressBar x:Name="MeterInR" Minimum="0" Maximum="100" Height="4.5" CornerRadius="2" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Out Level -->
                    <Border Background="#090D15" BorderBrush="#192537" BorderThickness="1" CornerRadius="8" Padding="8,4" Width="105" Height="48">
                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="OUT L/R" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="OutDbfsText" Text="-∞ dB" FontSize="8.5" FontFamily="Consolas, Cascadia Code, monospace" HorizontalAlignment="Right" Foreground="#F59E0B"/>
                            </Grid>
                            <ProgressBar x:Name="MeterOutL" Minimum="0" Maximum="100" Height="4.5" CornerRadius="2" Foreground="#F59E0B"/>
                            <ProgressBar x:Name="MeterOutR" Minimum="0" Maximum="100" Height="4.5" CornerRadius="2" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <!-- Limiter Badge -->
                    <Border x:Name="LimiterBadge" Background="#1E1710" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="8,6" VerticalAlignment="Center" Height="48">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="BRICKWALL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LimiterBadgeText" Text="LIMITER SAFE" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Mini-HUD Toggle -->
                    <Button x:Name="MiniHudButton" Click="ToggleMiniHud_Click" Height="48" Padding="8,0" CornerRadius="8" Background="#121D2C" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="⛶" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="MINI-HUD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace with Segmented Top Navigation -->
        <NavigationView Grid.Row="2" x:Name="MainNavView" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Top" SelectionChanged="MainNavView_SelectionChanged" Margin="14,0,14,10">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Quick Tune" Tag="QuickTune" Icon="MusicInfo"/>
                <NavigationViewItem Content="Studio EQ" Tag="StudioEq" Icon="Audio"/>
                <NavigationViewItem Content="AutoEQ Headphones" Tag="AutoEq" Icon="Library"/>
                <NavigationViewItem Content="7.1 Spatial Surround" Tag="Spatial" Icon="Rotate"/>
                <NavigationViewItem Content="Routing &amp; Doctor" Tag="Routing" Icon="Repair"/>
            </NavigationView.MenuItems>

            <Grid Padding="0,10,0,0">
                <!-- ============================================================== -->
                <!-- SECTION 1: QUICK TUNE (TACTILE MACRO STUDIO)                   -->
                <!-- ============================================================== -->
                <Grid x:Name="QuickTuneSection" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Active Sound Profile Header -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <Border Background="#1C2E46" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                    <TextBlock x:Name="ActiveProfileNameText" Text="Harman Target Reference" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <TextBlock x:Name="ActiveProfileCategoryText" Text="• Studio Calibration" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="💾 Save Profile" Click="SaveProfile_Click" FontSize="11" Padding="10,4" CornerRadius="6"/>
                                <Button Content="📥 Import JSON" Click="ImportProfile_Click" FontSize="11" Padding="10,4" CornerRadius="6"/>
                                <Button Content="📤 Export JSON" Click="ExportProfile_Click" FontSize="11" Padding="10,4" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4 Compact Tactile Audio Macro Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Macro 1: Bass Punch -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCard}" BorderBrush="#2C3D5A">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" Background="#1B2844" CornerRadius="8">
                                            <TextBlock Text="🔊" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Bass Punch &amp; Sub" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                            <TextBlock Text="Subwoofer slam" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="#192842" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="BassValText" Text="+0.0 dB" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="BassSlider" Minimum="0" Maximum="12" Value="0" StepFrequency="0.5" ValueChanged="MacroSlider_ValueChanged" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Macro 2: Vocal Clarity -->
                        <Border Grid.Column="1" Style="{StaticResource GlassCard}" BorderBrush="#3D2E55">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" Background="#281B3E" CornerRadius="8">
                                            <TextBlock Text="🎙️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Vocal &amp; Speech" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                            <TextBlock Text="Dialogue clarity" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="#2B1A42" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="VocalValText" Text="+0.0 dB" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource NeonVioletBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="VocalSlider" Minimum="0" Maximum="10" Value="0" StepFrequency="0.5" ValueChanged="MacroSlider_ValueChanged" Foreground="{StaticResource NeonVioletBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Macro 3: 3D Soundstage -->
                        <Border Grid.Column="2" Style="{StaticResource GlassCard}" BorderBrush="#204A55">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" Background="#14343E" CornerRadius="8">
                                            <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="3D Soundstage" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                            <TextBlock Text="Width expansion" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="#143834" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="SpatialValText" Text="0%" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </Grid>
                                <Slider x:Name="SpatialWidthSlider" Minimum="0" Maximum="100" Value="0" StepFrequency="5" ValueChanged="MacroSlider_ValueChanged" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Macro 4: Night Mode -->
                        <Border Grid.Column="3" Style="{StaticResource GlassCard}" BorderBrush="#42352B">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" Background="#33241C" CornerRadius="8">
                                            <TextBlock Text="🌙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Night Mode" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                            <TextBlock Text="Dynamic leveler" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NightModeToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="NightModeToggle_Toggled"/>
                                </Grid>
                                <TextBlock Text="Tames loud explosions; elevates quiet dialogue." FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Presets Showcase -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Curated Sound Profiles (One-Click Application)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <!-- Gaming Presets -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🎮 GAMING &amp; ESPORTS COMPETITIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <GridView x:Name="GamingPresetsGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PresetCard_Click">
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="285" Height="84" Style="{StaticResource GlassCard}" Margin="0,0,8,8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>

                                <!-- Music Presets -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🎵 AUDIOPHILE &amp; MUSIC MASTERING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NeonVioletBrush}"/>
                                    <GridView x:Name="MusicPresetsGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PresetCard_Click">
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="285" Height="84" Style="{StaticResource GlassCard}" Margin="0,0,8,8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>

                                <!-- Media Presets -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🎬 CINEMATIC MOVIES &amp; PODCASTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    <GridView x:Name="MediaPresetsGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PresetCard_Click">
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="285" Height="84" Style="{StaticResource GlassCard}" Margin="0,0,8,8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- SECTION 2: STUDIO EQ (UNIFIED STAGE + 11-BAND RACK)            -->
                <!-- ============================================================== -->
                <Grid x:Name="StudioEqSection" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Unified DAW Visualizer Stage: Combined Real-Time Spectrum Analyzer + Mathematical EQ Curve -->
                    <Border Grid.Row="0" Background="#0A0E17" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                        <Grid>
                            <!-- Real-Time Spectrum Background -->
                            <Canvas x:Name="SpectrumCanvas" SizeChanged="SpectrumCanvas_SizeChanged" Opacity="0.5"/>

                            <!-- Foreground Interactive Frequency Response Canvas -->
                            <Canvas x:Name="ResponseCanvas" SizeChanged="ResponseCanvas_SizeChanged"
                                    Background="Transparent"
                                    PointerPressed="ResponseCanvas_PointerPressed"
                                    PointerMoved="ResponseCanvas_PointerMoved"
                                    PointerReleased="ResponseCanvas_PointerReleased"
                                    PointerWheelChanged="ResponseCanvas_PointerWheelChanged"/>

                            <!-- Top Badges -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="44,8" VerticalAlignment="Top">
                                <Border Background="#1C2E46" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="UNIFIED STUDIO VISUALIZER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <TextBlock Text="· 64-Bin Real-Time FFT &amp; Multi-Biquad Transfer Curve" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" Margin="16,8" VerticalAlignment="Top">
                                <TextBlock x:Name="SpectrumPeakText" Text="Peak: Paused" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="FrequencyRangeText" Text="31 Hz – 16 kHz · 11 Studio Bands" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 11-Band Parametric Hardware Fader Console (Stretched across full width) -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="4,0,4,8">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="11-Band Studio Mastering Console" Style="{StaticResource SectionTitle}"/>
                                    <Border Background="#1A293E" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="31 Hz Sub-Bass to 16 kHz Air" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="· Precision Octave Faders" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="↺ Reset All Bands to Flat" Click="ResetAllBands_Click" HorizontalAlignment="Right" FontSize="11" Padding="12,4" CornerRadius="6"/>
                            </Grid>

                            <!-- The 11 Channel Strips (Grid with 11 equal width columns) -->
                            <Grid Grid.Row="1" x:Name="BandsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- SECTION 3: AUTOEQ HEADPHONE CALIBRATION LIBRARY                -->
                <!-- ============================================================== -->
                <Grid x:Name="AutoEqSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="AutoEQ Headphone Calibration Library" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Compensate headphone acoustic anomalies with laboratory-calibrated Harman Target Curves." FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="HeadphoneSearchBox" PlaceholderText="Search headphone model or brand…" Width="320" TextChanged="HeadphoneSearchBox_TextChanged" CornerRadius="8"/>
                        </Grid>

                        <!-- Filter Chips Row -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="ChipAll" Content="All Models" Click="FilterChip_Click" Tag="All" Background="#0072CE" Foreground="White" FontSize="11" Padding="14,4" CornerRadius="6"/>
                            <Button x:Name="ChipOverEar" Content="Over-Ear ANC" Click="FilterChip_Click" Tag="Over-Ear" FontSize="11" Padding="14,4" CornerRadius="6"/>
                            <Button x:Name="ChipInEar" Content="In-Ear / IEM" Click="FilterChip_Click" Tag="In-Ear" FontSize="11" Padding="14,4" CornerRadius="6"/>
                            <Button x:Name="ChipStudio" Content="Studio Reference" Click="FilterChip_Click" Tag="Studio" FontSize="11" Padding="14,4" CornerRadius="6"/>
                            <Button x:Name="ChipGaming" Content="Gaming Headsets" Click="FilterChip_Click" Tag="Gaming" FontSize="11" Padding="14,4" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Row 2: Acoustic Harman Target Calibration Stage (Before vs After) -->
                        <Border Grid.Row="2" Margin="0,12,0,0" Background="#080D15" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="100"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Header & A/B Audio Switch -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="#1C2E46" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="HARMAN LAB CALIBRATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="SelectedHeadphoneTitle" Text="Sony WH-1000XM5: Harman Target Correction Matrix" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#162334" CornerRadius="4" Padding="5,1.5">
                                            <TextBlock Text="--- Stock Flaw" FontSize="8.5" Foreground="#F59E0B"/>
                                        </Border>
                                        <Border Background="#162334" CornerRadius="4" Padding="5,1.5">
                                            <TextBlock Text="— Harman Target" FontSize="8.5" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <ToggleSwitch x:Name="HeadphoneAbToggle" OffContent="🎧 Stock Sound" OnContent="🎯 Harman Calibrated" Toggled="HeadphoneAbToggle_Toggled" FontSize="10" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Mini Response Canvas (Raw Anomaly vs Corrected Target) -->
                                <Canvas Grid.Row="1" x:Name="AutoEqCanvas" SizeChanged="AutoEqCanvas_SizeChanged"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <GridView x:Name="HeadphoneCardsGrid" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="330" Height="145" Style="{StaticResource GlassCard}" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Brand Badge & Harman Match -->
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="#1C2E46" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Manufacturer}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Background="#16382C" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="🎯 98% Harman Match" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,6"/>

                                            <!-- Bottom Action Row -->
                                            <Grid Grid.Row="2">
                                                <Border Background="#182338" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                                                </Border>
                                                <Button Content="⚡ Calibrate EQ" HorizontalAlignment="Right" Click="ApplyHeadphoneProfile_Click" Tag="{Binding Id}" Background="#122438" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Padding="14,3" CornerRadius="6"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>
                </Grid>

                <!-- ============================================================== -->
                <!-- SECTION 4: 7.1 SPATIAL ACOUSTIC RADAR & MATRIX                 -->
                <!-- ============================================================== -->
                <Grid x:Name="SpatialSection" Visibility="Collapsed" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Circular 3D Sonar Acoustic Radar -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <TextBlock Text="7.1 Acoustic Speaker Virtualization" Style="{StaticResource SectionTitle}"/>
                                <ToggleSwitch x:Name="SpatialEngineToggle" Header="3D Spatial Engine" Toggled="SpatialControl_Changed"/>

                                <!-- Perfect Circular Acoustic Sonar Stage -->
                                <Border Width="240" Height="240" Background="#0C1320" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5" CornerRadius="120" HorizontalAlignment="Center">
                                    <Canvas>
                                        <!-- Concentric Sonar Rings -->
                                        <Ellipse Width="200" Height="200" Stroke="#182A42" StrokeThickness="1" Canvas.Left="20" Canvas.Top="20"/>
                                        <Ellipse Width="130" Height="130" Stroke="#1D3656" StrokeThickness="1" Canvas.Left="55" Canvas.Top="55"/>
                                        <Ellipse Width="60" Height="60" Stroke="#254772" StrokeThickness="1" Canvas.Left="90" Canvas.Top="90"/>

                                        <!-- Speaker Satellite Nodes -->
                                        <Border Background="#1C2E44" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="98" Canvas.Top="6">
                                            <TextBlock Text="CENTER" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1C2E44" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="26" Canvas.Top="38">
                                            <TextBlock Text="FL" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1C2E44" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="180" Canvas.Top="38">
                                            <TextBlock Text="FR" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#33241C" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="6" Canvas.Top="108">
                                            <TextBlock Text="SUB LFE" FontSize="8" FontWeight="Bold" Foreground="#F59E0B"/>
                                        </Border>
                                        <Border Background="#1C2E44" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="10" Canvas.Top="150">
                                            <TextBlock Text="SL" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1C2E44" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="196" Canvas.Top="150">
                                            <TextBlock Text="SR" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1C2E44" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="46" Canvas.Top="198">
                                            <TextBlock Text="RL" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1C2E44" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Canvas.Left="160" Canvas.Top="198">
                                            <TextBlock Text="RR" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>

                                        <!-- Center Listener Avatar -->
                                        <Ellipse Width="42" Height="42" Fill="#23354E" Canvas.Left="99" Canvas.Top="99"/>
                                        <TextBlock Text="🎧" FontSize="19" Canvas.Left="110" Canvas.Top="108"/>
                                    </Canvas>
                                </Border>

                                <!-- 3 Master Sliders -->
                                <StackPanel Spacing="5">
                                    <Grid>
                                        <TextBlock Text="Virtualization Depth" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="DepthValText" Text="60%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                                    </Grid>
                                    <Slider x:Name="DepthSlider" Minimum="0" Maximum="100" Value="60" ValueChanged="SpatialSlider_ValueChanged" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <Grid>
                                        <TextBlock Text="Room Ambience Reverb" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="AmbienceValText" Text="45%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource NeonVioletBrush}"/>
                                    </Grid>
                                    <Slider x:Name="AmbienceSlider" Minimum="0" Maximum="100" Value="45" ValueChanged="SpatialSlider_ValueChanged" Foreground="{StaticResource NeonVioletBrush}"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <Grid>
                                        <TextBlock Text="Wet / Dry Spatial Mix" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="MixValText" Text="80%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}"/>
                                    </Grid>
                                    <Slider x:Name="MixSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="SpatialSlider_ValueChanged" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Speaker Panning Matrix (Structured 2-column channel strip) -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Channel Balance &amp; Speaker Panning Matrix" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Adjust balance and virtual distance for individual surround channels." FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                <StackPanel x:Name="NodePansPanel" Spacing="8" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- SECTION 5: ROUTING & SELF-HEALING AUDIO DOCTOR                 -->
                <!-- ============================================================== -->
                <Grid x:Name="RoutingSection" Visibility="Collapsed" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Device Routing & Buffer Topology -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Audio Hardware &amp; Virtual Endpoint Routing" Style="{StaticResource SectionTitle}"/>
                                
                                <ComboBox x:Name="SourcePicker" Header="Virtual Capture Device (AudioFlow Input)" HorizontalAlignment="Stretch" SelectionChanged="DevicePicker_SelectionChanged" CornerRadius="6"/>
                                <TextBlock Text="Windows sends multimedia audio to this virtual endpoint for real-time DSP processing." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

                                <ComboBox x:Name="OutputPicker" Header="Hardware Playback Device (Physical Speakers / DAC)" HorizontalAlignment="Stretch" SelectionChanged="DevicePicker_SelectionChanged" CornerRadius="6"/>
                                <TextBlock Text="AudioFlow outputs processed audio directly to your physical speakers or headphones." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

                                <Border Background="#101927" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Audio Route Status" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock x:Name="RouteStatusText" Text="Checking audio devices…" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#101927" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Buffer Pipeline Telemetry" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock x:Name="BufferStatusText" Text="Audio buffer: stopped" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Self-Healing Audio Doctor & Panic Recovery -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <TextBlock Text="🩺 Audio Doctor &amp; Self-Healing Diagnostics" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Automated diagnostics inspecting WASAPI endpoint buffers, clock jitter, and system default devices." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

                                <Button Content="Run Self-Healing Diagnostic" Click="RunDiagnostics_Click" HorizontalAlignment="Stretch" Height="38" Background="#0072CE" Foreground="White" FontWeight="Bold" CornerRadius="8"/>

                                <Border Background="#181824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Diagnostic Audit Results" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource WarningBrush}"/>
                                        <TextBlock x:Name="DiagnosticResultsText" Text="Click 'Run Self-Healing Diagnostic' to inspect system audio health." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Background="#241418" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Emergency Sound Recovery" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="If audio stops unexpectedly, click this button to restore Windows sound back to physical hardware speakers." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        <Button Content="Restore Default Windows Audio" Click="RestoreDefaultAudio_Click" HorizontalAlignment="Stretch" Height="34" Background="{StaticResource DangerBrush}" Foreground="White" FontWeight="Bold" CornerRadius="8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Compact Gamer Mini-HUD Floating Deck -->
        <Border x:Name="GamerHudView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
                Background="#080C14" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="14"
                Margin="14,0,14,10" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mini-HUD Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="#122538" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="⚡ ESPORTS MINI-HUD" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                        </Border>
                        <TextBlock x:Name="MiniHudProfileText" Text="Tactical Steps · Valorant &amp; CS2" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="ToggleMiniHud_Click" HorizontalAlignment="Right" Background="#162234" Foreground="#00E5FF" FontSize="10" Padding="8,3" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⛶" FontSize="11"/>
                            <TextBlock Text="FULL STUDIO" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Mini-HUD Quick Tuning & Esports Profiles Matrix -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Quick Faders & Esports Mode Buttons -->
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="🎯 Valorant / CS2" Click="MiniHudEsports_Click" Tag="valorant-cs2" FontSize="10" Padding="8,3" CornerRadius="4" Background="#162A40" Foreground="#00E5FF"/>
                            <Button Content="💥 Warzone Dampener" Click="MiniHudEsports_Click" Tag="warzone-steps" FontSize="10" Padding="8,3" CornerRadius="4" Background="#162334" Foreground="#F59E0B"/>
                            <Button Content="⚡ Apex Intel" Click="MiniHudEsports_Click" Tag="apex-legends" FontSize="10" Padding="8,3" CornerRadius="4" Background="#1B1F34" Foreground="#A855F7"/>
                        </StackPanel>

                        <!-- Mini Preamp Slider -->
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Preamp Volume" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MiniHudPreampText" Text="0.0 dB" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="MiniHudPreampSlider" Minimum="-15" Maximum="15" Value="0" StepFrequency="0.5" ValueChanged="MiniHudPreampSlider_ValueChanged" Foreground="#00E5FF" Height="26"/>
                    </StackPanel>

                    <!-- Right: Quick Toggles Stack -->
                    <Border Grid.Column="1" Background="#0F1726" BorderBrush="#1C2B42" BorderThickness="1" CornerRadius="8" Padding="8,6">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <Button Content="⇄ Fast A/B" Click="QuickAbCompare_Click" HorizontalAlignment="Stretch" FontSize="10" Padding="4,3" CornerRadius="4" Background="#1C2E46" Foreground="White"/>
                            <ToggleSwitch x:Name="MiniHudBypassToggle" Header="" OffContent="DSP Active" OnContent="Bypassed" Toggled="MiniHudBypassToggle_Toggled" FontSize="9.5" Height="28"/>
                            <CheckBox x:Name="MiniHudAutoGainCheck" Content="Auto-Gain" Click="AutoGainCheck_Click" FontSize="9.5" Foreground="{StaticResource MutedBrush}" Height="20"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Mini Status Footer -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock x:Name="MiniHudTelemetryText" Text="Latency: 25ms Ultra · Safety Limiter: Active" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="AudioFlow 64-Bit DSP" FontSize="8.5" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
