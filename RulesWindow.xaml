<Window x:Class="AudioFlow.RulesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindowStyle}" Title="AudioFlow automation" Width="800" Height="470" MinWidth="560" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Automation rules" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Top matching rule wins. Use Up / Down to set priority. App names match exactly, with or without .exe." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18" TextWrapping="Wrap"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Rules}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold"><Run Text="{Binding TriggerType}"/><Run Text="  →  "/><Run Text="{Binding Match}"/></TextBlock><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Up" Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="3,0"/><Button Content="Down" Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="3,0"/><Button Content="Remove" Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="Rules are saved automatically." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="＋ Add rule" Command="{Binding AddRuleCommand}" Background="#796BFF" Margin="0,0,8,0"/><Button Content="Done" IsCancel="True"/></StackPanel></DockPanel></Grid>
</Window>
